  "scene_actions": [
    {
      "key": "refresh_data",
      "label": {
        "en": "Refresh Withings data",
        "fr": "Actualiser les données Withings",
        "de": "Withings-Daten aktualisieren",
        "es": "Actualizar los datos de Withings"
      },
      "description": {
        "en": "Read Withings now instead of waiting for the next refresh.",
        "fr": "Lit Withings maintenant au lieu d'attendre le prochain rafraîchissement.",
        "de": "Liest Withings jetzt, statt auf die nächste Aktualisierung zu warten.",
