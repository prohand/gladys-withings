{
  "manifest_version": 1,
  "type": "device",
  "name": "Withings",
  "description": {
    "en": "Weight, blood pressure, activity and sleep from your Withings scales, watches and monitors.",
    "fr": "Poids, tension, activité et sommeil de vos balances, montres et tensiomètres Withings.",
    "de": "Gewicht, Blutdruck, Aktivität und Schlaf deiner Withings-Waagen, -Uhren und -Messgeräte.",
    "es": "Peso, tensión, actividad y sueño de sus básculas, relojes y tensiómetros Withings."
  },
  "version": "1.1.0",
  "docker_image": "ghcr.io/prohand/gladys-withings:1.1.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-withings/main/cover.png",
  "categories": ["services"],
  "keywords": [
    "health mate",
    "body cardio",
    "body scan",
    "scanwatch",
    "sleep analyzer",
    "thermo",
    "nokia health",
    "heart rate",
    "spo2",
    "body composition"
  ],
  "transports": ["cloud"],
  "webhooks": [
    {
      "key": "notify",
      "label": {
        "en": "Withings notifications",
        "fr": "Notifications Withings",
        "de": "Withings-Benachrichtigungen",
        "es": "Notificaciones de Withings"
      },
      "mode": "fire_and_forget"
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Withings data comes from the Withings cloud, through a developer app of your own (free). 1. On developer.withings.com, create an application (Public API integration). 2. Add the callback URL of your Gladys: click Connect once below, then run \"Test the connection\" to see it, or read it in the integration logs. 3. Copy the Client ID and the Client secret here, save, then click Connect and sign in to Withings.",
        "fr": "Les données Withings viennent du cloud Withings, via une application développeur à vous (gratuite). 1. Sur developer.withings.com, créez une application (Public API integration). 2. Ajoutez l'URL de rappel de votre Gladys : cliquez une fois sur Connecter ci-dessous, puis lancez « Tester la connexion » pour la voir, ou lisez-la dans les logs de l'intégration. 3. Copiez ici le Client ID et le Client secret, enregistrez, puis cliquez sur Connecter et identifiez-vous chez Withings.",
        "de": "Die Withings-Daten kommen aus der Withings-Cloud, über eine eigene (kostenlose) Entwickler-App. 1. Erstelle auf developer.withings.com eine Anwendung (Public API integration). 2. Füge die Callback-URL deines Gladys hinzu: klicke unten einmal auf Verbinden und starte dann „Verbindung testen“, um sie zu sehen, oder lies sie in den Logs der Integration. 3. Kopiere Client-ID und Client-Secret hierher, speichere, klicke dann auf Verbinden und melde dich bei Withings an.",
        "es": "Los datos de Withings vienen de la nube de Withings, a través de una aplicación de desarrollador propia (gratuita). 1. En developer.withings.com, cree una aplicación (Public API integration). 2. Añada la URL de retorno de su Gladys: haga clic una vez en Conectar abajo y luego ejecute «Probar la conexión» para verla, o léala en los registros de la integración. 3. Copie aquí el Client ID y el Client secret, guarde, luego haga clic en Conectar e inicie sesión en Withings."
      },
      "links": [
        {
          "url": "https://developer.withings.com/dashboard/",
          "label": {
            "en": "Withings developer dashboard",
            "fr": "Espace développeur Withings",
            "de": "Withings-Entwicklerbereich",
            "es": "Panel de desarrollador de Withings"
          }
        },
        {
          "url": "https://github.com/prohand/gladys-withings/blob/main/docs/en.md",
          "label": {
            "en": "Integration documentation",
            "fr": "Documentation de l'intégration",
            "de": "Dokumentation der Integration",
            "es": "Documentación de la integración"
          }
        }
      ]
    },
    {
      "key": "client_id",
      "type": "string",
      "label": {
        "en": "Client ID",
        "fr": "Client ID",
        "de": "Client-ID",
        "es": "Client ID"
      },
      "description": {
        "en": "The Client ID of your Withings application.",
        "fr": "Le Client ID de votre application Withings.",
        "de": "Die Client-ID deiner Withings-Anwendung.",
        "es": "El Client ID de su aplicación Withings."
      },
      "placeholder": {
        "en": "e.g. 3a7f...c91",
        "fr": "ex. 3a7f...c91",
        "de": "z. B. 3a7f...c91",
        "es": "p. ej. 3a7f...c91"
      },
      "required": true
    },
    {
      "key": "client_secret",
      "type": "secret",
      "label": {
        "en": "Client secret",
        "fr": "Client secret",
        "de": "Client-Secret",
        "es": "Client secret"
      },
      "description": {
        "en": "The Client secret of your Withings application. Stored in Gladys, never shown again.",
        "fr": "Le Client secret de votre application Withings. Stocké dans Gladys, jamais réaffiché.",
        "de": "Das Client-Secret deiner Withings-Anwendung. In Gladys gespeichert, nie wieder angezeigt.",
        "es": "El Client secret de su aplicación Withings. Guardado en Gladys, nunca se vuelve a mostrar."
      },
      "required": true
    },
    {
      "key": "withings_account",
      "type": "oauth2",
      "label": {
        "en": "Withings account",
        "fr": "Compte Withings",
        "de": "Withings-Konto",
        "es": "Cuenta Withings"
      },
      "description": {
        "en": "Save the Client ID and secret first, then click Connect and sign in to Withings.",
        "fr": "Enregistrez d'abord le Client ID et le secret, puis cliquez sur Connecter et identifiez-vous chez Withings.",
        "de": "Speichere zuerst Client-ID und Secret, klicke dann auf Verbinden und melde dich bei Withings an.",
        "es": "Guarde primero el Client ID y el secret, luego haga clic en Conectar e inicie sesión en Withings."
      }
    },
    {
      "key": "refresh_interval",
      "type": "number",
      "label": {
        "en": "Refresh interval (min)",
        "fr": "Intervalle de rafraîchissement (min)",
        "de": "Aktualisierungsintervall (min)",
        "es": "Intervalo de actualización (min)"
      },
      "description": {
        "en": "How often Withings is read, in minutes. With Gladys Plus, new measures also arrive within seconds.",
        "fr": "Fréquence de lecture de Withings, en minutes. Avec Gladys Plus, les nouvelles mesures arrivent aussi en quelques secondes.",
        "de": "Wie oft Withings gelesen wird, in Minuten. Mit Gladys Plus kommen neue Messungen zusätzlich innerhalb von Sekunden an.",
        "es": "Cada cuánto se lee Withings, en minutos. Con Gladys Plus, las nuevas mediciones también llegan en segundos."
      },
      "required": false,
      "default": 30,
      "min": 5,
      "max": 1440
    },
    {
      "key": "steps_goal",
      "type": "number",
      "label": {
        "en": "Daily steps goal",
        "fr": "Objectif de pas quotidien",
        "de": "Tägliches Schrittziel",
        "es": "Objetivo diario de pasos"
      },
      "description": {
        "en": "The \"Steps goal reached\" scene trigger fires once a day when today's steps reach it.",
        "fr": "Le déclencheur de scène « Objectif de pas atteint » se déclenche une fois par jour quand les pas du jour l'atteignent.",
        "de": "Der Szenenauslöser „Schrittziel erreicht“ wird einmal am Tag ausgelöst, wenn die heutigen Schritte es erreichen.",
        "es": "El disparador de escena «Objetivo de pasos alcanzado» se activa una vez al día cuando los pasos de hoy lo alcanzan."
      },
      "required": false,
      "default": 10000,
      "min": 100,
      "max": 100000
    },
    {
      "key": "use_webhooks",
      "type": "boolean",
      "label": {
        "en": "Real-time notifications (Gladys Plus)",
        "fr": "Notifications temps réel (Gladys Plus)",
        "de": "Echtzeit-Benachrichtigungen (Gladys Plus)",
        "es": "Notificaciones en tiempo real (Gladys Plus)"
      },
      "description": {
        "en": "Ask Withings to notify Gladys of new data through Gladys Plus: measures in seconds, and the \"in bed\" / \"out of bed\" events of a Sleep Analyzer. Without Gladys Plus, the refresh interval applies.",
        "fr": "Demande à Withings de prévenir Gladys des nouvelles données via Gladys Plus : les mesures en quelques secondes, et les événements « au lit » / « hors du lit » d'un Sleep Analyzer. Sans Gladys Plus, l'intervalle de rafraîchissement s'applique.",
        "de": "Bittet Withings, Gladys über Gladys Plus über neue Daten zu informieren: Messungen in Sekunden und die Ereignisse „im Bett“ / „aus dem Bett“ eines Sleep Analyzer. Ohne Gladys Plus gilt das Aktualisierungsintervall.",
        "es": "Pide a Withings que avise a Gladys de los nuevos datos a través de Gladys Plus: mediciones en segundos y los eventos «en la cama» / «fuera de la cama» de un Sleep Analyzer. Sin Gladys Plus, se aplica el intervalo de actualización."
      },
      "required": false,
      "default": true
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    },
    {
      "key": "sync_now",
      "label": {
        "en": "Synchronize now",
        "fr": "Synchroniser maintenant",
        "de": "Jetzt synchronisieren",
        "es": "Sincronizar ahora"
      },
      "timeout_seconds": 90
    },
    {
      "key": "unlink_account",
      "label": {
        "en": "Disconnect the Withings account",
        "fr": "Déconnecter le compte Withings",
        "de": "Withings-Konto trennen",
        "es": "Desconectar la cuenta Withings"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
